{
  "name": "saturn-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/precompress.mjs dist",
    "preview": "node scripts/serve.mjs dist 4181",
    "analyze": "vite build --mode analyze",
    "build:analyze": "vite build --mode analyze && node scripts/check-budget.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:reduced": "playwright test --project=reduced-motion",
    "test:perf": "node scripts/check-budget.mjs --build && node test/perf/lighthouse.mjs && node test/perf/fps.mjs",
    "test": "npm run lint && npm run test:unit && playwright test",
    "build:file": "vite build --mode file"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^8.3.1"
  }
}
